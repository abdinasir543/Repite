<!DOCTYPE html>
<html lang="so">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Repite — Barasho Luuqadaha</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0f1e;
    --card: #111827;
    --accent: #00e5a0;
    --accent2: #7c3aed;
    --text: #f0f4ff;
    --muted: #6b7280;
    --wrong: #ef4444;
    --right: #00e5a0;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Sora', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 16px 40px;
    background-image: radial-gradient(ellipse at 20% 20%, rgba(124,58,237,0.15) 0%, transparent 60%),
                      radial-gradient(ellipse at 80% 80%, rgba(0,229,160,0.1) 0%, transparent 60%);
  }

  header {
    width: 100%;
    max-width: 480px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0 24px;
  }

  .logo {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--accent);
  }

  .logo span { color: var(--accent2); }

  .score-badge {
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    background: rgba(0,229,160,0.1);
    border: 1px solid rgba(0,229,160,0.3);
    color: var(--accent);
    padding: 6px 14px;
    border-radius: 999px;
  }

  /* TABS */
  .tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    background: var(--card);
    border-radius: 12px;
    padding: 4px;
    width: 100%;
    max-width: 480px;
  }

  .tab {
    flex: 1;
    padding: 10px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-family: 'Sora', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .tab.active {
    background: var(--accent);
    color: #0a0f1e;
  }

  /* SCREENS */
  .screen { display: none; width: 100%; max-width: 480px; }
  .screen.active { display: block; }

  /* FLASHCARD */
  .card-area {
    perspective: 1000px;
    margin-bottom: 24px;
  }

  .flashcard {
    width: 100%;
    height: 220px;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(.4,0,.2,1);
    cursor: pointer;
    border-radius: 20px;
  }

  .flashcard.flipped { transform: rotateY(180deg); }

  .card-face {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    padding: 24px;
  }

  .card-front {
    background: linear-gradient(135deg, #111827, #1e1b4b);
    border: 1px solid rgba(124,58,237,0.4);
  }

  .card-back {
    background: linear-gradient(135deg, #0a2e1f, #0a1f2e);
    border: 1px solid rgba(0,229,160,0.4);
    transform: rotateY(180deg);
  }

  .card-lang {
    font-size: 0.7rem;
    font-family: 'Space Mono', monospace;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .card-word {
    font-size: 2.2rem;
    font-weight: 800;
    text-align: center;
    line-height: 1.1;
  }

  .card-front .card-word { color: var(--accent2); }
  .card-back .card-word { color: var(--accent); }

  .card-hint {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 16px;
    font-style: italic;
  }

  .card-nav {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .btn {
    flex: 1;
    padding: 14px;
    border: none;
    border-radius: 12px;
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-prev { background: var(--card); color: var(--text); border: 1px solid #2d3748; }
  .btn-next { background: var(--accent); color: #0a0f1e; }
  .btn:active { transform: scale(0.97); }

  .progress-bar {
    width: 100%;
    height: 4px;
    background: #1e2535;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent2), var(--accent));
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  .progress-text {
    font-size: 0.75rem;
    color: var(--muted);
    font-family: 'Space Mono', monospace;
    text-align: center;
  }

  /* QUIZ */
  .quiz-question {
    background: var(--card);
    border-radius: 20px;
    padding: 28px 20px;
    margin-bottom: 20px;
    text-align: center;
    border: 1px solid #1e2535;
  }

  .quiz-q-label {
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-family: 'Space Mono', monospace;
    margin-bottom: 12px;
  }

  .quiz-word {
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent2);
  }

  .quiz-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .quiz-option {
    background: var(--card);
    border: 2px solid #1e2535;
    border-radius: 14px;
    padding: 16px 12px;
    font-family: 'Sora', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }

  .quiz-option:hover { border-color: var(--accent2); }
  .quiz-option.correct { border-color: var(--right); background: rgba(0,229,160,0.1); color: var(--right); }
  .quiz-option.wrong { border-color: var(--wrong); background: rgba(239,68,68,0.1); color: var(--wrong); }
  .quiz-option:disabled { cursor: not-allowed; }

  .quiz-feedback {
    text-align: center;
    font-size: 1rem;
    font-weight: 700;
    min-height: 28px;
    margin-bottom: 12px;
  }

  .btn-full {
    width: 100%;
    padding: 16px;
    border-radius: 14px;
    font-size: 1rem;
  }

  /* SCOREBOARD */
  .score-screen { text-align: center; }

  .score-circle {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 4px solid var(--accent);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    background: rgba(0,229,160,0.05);
    box-shadow: 0 0 40px rgba(0,229,160,0.2);
  }

  .score-num {
    font-size: 2.8rem;
    font-weight: 800;
    font-family: 'Space Mono', monospace;
    color: var(--accent);
    line-height: 1;
  }

  .score-label { font-size: 0.75rem; color: var(--muted); margin-top: 4px; }

  .score-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: var(--card);
    border-radius: 14px;
    padding: 16px;
    border: 1px solid #1e2535;
  }

  .stat-val {
    font-size: 1.6rem;
    font-weight: 800;
    font-family: 'Space Mono', monospace;
  }

  .stat-val.green { color: var(--accent); }
  .stat-val.red { color: var(--wrong); }
  .stat-label { font-size: 0.75rem; color: var(--muted); margin-top: 4px; }

  .section-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text);
  }

  @keyframes pop {
    0% { transform: scale(0.8); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .pop { animation: pop 0.3s ease forwards; }
</style>
</head>
<body>

<header>
  <div class="logo">Re<span>pi</span>te</div>
  <div class="score-badge" id="totalScore">⭐ 0 dhibcood</div>
</header>

<div class="tabs">
  <button class="tab active" onclick="showTab('flash')">🃏 Flashcards</button>
  <button class="tab" onclick="showTab('quiz')">🎯 Quiz</button>
  <button class="tab" onclick="showTab('score')">🏆 Score</button>
</div>

<!-- FLASHCARDS -->
<div class="screen active" id="flash">
  <div class="card-area">
    <div class="flashcard" id="flashcard" onclick="flipCard()">
      <div class="card-face card-front">
        <div class="card-lang">🇸🇴 Soomaali</div>
        <div class="card-word" id="soWord">Biyo</div>
        <div class="card-hint">Taabo si aad u aragto Ingiriisiga</div>
      </div>
      <div class="card-face card-back">
        <div class="card-lang">🇬🇧 Ingiriisi</div>
        <div class="card-word" id="enWord">Water</div>
      </div>
    </div>
  </div>

  <div class="card-nav">
    <button class="btn btn-prev" onclick="prevCard()">← Hore</button>
    <button class="btn btn-next" onclick="nextCard()">Xiga →</button>
  </div>

  <div class="progress-bar">
    <div class="progress-fill" id="flashProgress" style="width:10%"></div>
  </div>
  <div class="progress-text" id="flashCount">1 / 10</div>
</div>

<!-- QUIZ -->
<div class="screen" id="quiz">
  <div class="quiz-question">
    <div class="quiz-q-label">Maxay tahay Ingiriisiga?</div>
    <div class="quiz-word" id="quizWord">Biyo</div>
  </div>

  <div class="quiz-options" id="quizOptions"></div>
  <div class="quiz-feedback" id="quizFeedback"></div>
  <button class="btn btn-next btn-full" id="nextQuizBtn" onclick="nextQuiz()" style="display:none">Xiga →</button>
</div>

<!-- SCOREBOARD -->
<div class="screen" id="score">
  <div class="score-screen">
    <div class="score-circle">
      <div class="score-num" id="bigScore">0</div>
      <div class="score-label">Dhibcood</div>
    </div>

    <div class="score-stats">
      <div class="stat-card">
        <div class="stat-val green" id="correctCount">0</div>
        <div class="stat-label">✅ Saxan</div>
      </div>
      <div class="stat-card">
        <div class="stat-val red" id="wrongCount">0</div>
        <div class="stat-label">❌ Khalad</div>
      </div>
      <div class="stat-card">
        <div class="stat-val" id="totalAnswered" style="color:#a78bfa">0</div>
        <div class="stat-label">📝 Jawaab</div>
      </div>
      <div class="stat-card">
        <div class="stat-val" id="accuracy" style="color:#fbbf24">0%</div>
        <div class="stat-label">🎯 Sax%</div>
      </div>
    </div>

    <button class="btn btn-next btn-full" onclick="resetAll()">🔄 Dib u bilow</button>
  </div>
</div>

<script>
const words = [
  { so: "Biyo", en: "Water" },
  { so: "Cunto", en: "Food" },
  { so: "Guri", en: "House" },
  { so: "Buug", en: "Book" },
  { so: "Miis", en: "Table" },
  { so: "Kursi", en: "Chair" },
  { so: "Albaab", en: "Door" },
  { so: "Daaqad", en: "Window" },
  { so: "Dhar", en: "Clothes" },
  { so: "Gaari", en: "Car" },
  { so: "Xidid", en: "Root" },
  { so: "Cadceed", en: "Sun" },
  { so: "Dayax", en: "Moon" },
  { so: "Xiddig", en: "Star" },
  { so: "Biyaha", en: "River" },
  { so: "Geed", en: "Tree" },
  { so: "Ubax", en: "Flower" },
  { so: "Xayawaan", en: "Animal" },
  { so: "Wiil", en: "Boy" },
  { so: "Gabadh", en: "Girl" },
];

let currentCard = 0;
let isFlipped = false;
let totalScore = 0;
let correct = 0;
let wrong = 0;
let quizIndex = 0;
let quizWords = [];
let answered = false;

// FLASHCARDS
function updateCard() {
  isFlipped = false;
  document.getElementById('flashcard').classList.remove('flipped');
  document.getElementById('soWord').textContent = words[currentCard].so;
  document.getElementById('enWord').textContent = words[currentCard].en;
  const pct = ((currentCard + 1) / words.length * 100).toFixed(0);
  document.getElementById('flashProgress').style.width = pct + '%';
  document.getElementById('flashCount').textContent = (currentCard + 1) + ' / ' + words.length;
}

function flipCard() {
  isFlipped = !isFlipped;
  document.getElementById('flashcard').classList.toggle('flipped', isFlipped);
}

function nextCard() {
  currentCard = (currentCard + 1) % words.length;
  updateCard();
}

function prevCard() {
  currentCard = (currentCard - 1 + words.length) % words.length;
  updateCard();
}

// QUIZ
function shuffle(arr) { return [...arr].sort(() => Math.random() - 0.5); }

function loadQuiz() {
  quizWords = shuffle(words);
  quizIndex = 0;
  showQuiz();
}

function showQuiz() {
  answered = false;
  const w = quizWords[quizIndex % quizWords.length];
  document.getElementById('quizWord').textContent = w.so;
  document.getElementById('quizFeedback').textContent = '';
  document.getElementById('nextQuizBtn').style.display = 'none';

  const wrong4 = shuffle(words.filter(x => x.en !== w.en)).slice(0, 3);
  const opts = shuffle([w, ...wrong4]);

  const container = document.getElementById('quizOptions');
  container.innerHTML = '';
  opts.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'quiz-option';
    btn.textContent = opt.en;
    btn.onclick = () => checkAnswer(btn, opt.en, w.en);
    container.appendChild(btn);
  });
}

function checkAnswer(btn, chosen, correct_ans) {
  if (answered) return;
  answered = true;

  const allBtns = document.querySelectorAll('.quiz-option');
  allBtns.forEach(b => {
    b.disabled = true;
    if (b.textContent === correct_ans) b.classList.add('correct');
  });

  const fb = document.getElementById('quizFeedback');
  if (chosen === correct_ans) {
    btn.classList.add('correct');
    fb.textContent = '✅ Saxan! +10 dhibcood';
    fb.style.color = 'var(--accent)';
    totalScore += 10;
    correct++;
  } else {
    btn.classList.add('wrong');
    fb.textContent = '❌ Khalad! Jawaabta: ' + correct_ans;
    fb.style.color = 'var(--wrong)';
    wrong++;
  }

  updateScoreDisplay();
  document.getElementById('nextQuizBtn').style.display = 'block';
}

function nextQuiz() {
  quizIndex++;
  showQuiz();
}

function updateScoreDisplay() {
  document.getElementById('totalScore').textContent = '⭐ ' + totalScore + ' dhibcood';
  document.getElementById('bigScore').textContent = totalScore;
  document.getElementById('correctCount').textContent = correct;
  document.getElementById('wrongCount').textContent = wrong;
  const total = correct + wrong;
  document.getElementById('totalAnswered').textContent = total;
  document.getElementById('accuracy').textContent = total > 0 ? Math.round(correct/total*100) + '%' : '0%';
}

function resetAll() {
  totalScore = 0; correct = 0; wrong = 0;
  updateScoreDisplay();
  showTab('flash');
}

// TABS
function showTab(tab) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById(tab).classList.add('active');
  event.target.classList.add('active');
  if (tab === 'quiz') loadQuiz();
  if (tab === 'score') updateScoreDisplay();
}

updateCard();
</script>
</body>
</html>
